# Database connection string (PostgreSQL)
# Works with local PostgreSQL, Neon (https://neon.tech), or Supabase (https://supabase.com)
DATABASE_URL="postgresql://user:password@localhost:5432/rore_db?schema=public"

# App configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth / Auth.js configuration
# Generate a secret with: npx auth secret or openssl rand -base64 32
AUTH_SECRET="your-secure-random-secret-here"
# Optional single-IP header overwritten by your trusted ingress. Leave empty on a direct server.
AUTH_CLIENT_IP_HEADER=""

# Razorpay Test Mode Configuration
# Get your test keys from Razorpay Dashboard: Settings -> API Keys (Generate Test Key)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecretHere"

# Razorpay Webhook Secret (Settings -> Webhooks -> Add New Webhook)
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecretHere"

# Cloudinary Configuration (Signed Direct Media Uploads)
# Dashboard -> Settings -> Access Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Resend Transactional Email Configuration
# Get API Key from: https://resend.com/api-keys
RESEND_API_KEY="re_yourApiKeyHere"
# For test domains without custom DNS, use the verified Resend onboarding address:
EMAIL_FROM="RORE CLUB <onboarding@resend.dev>"

# Qikink Custom API. Leave blank for storefront preview and configure sandbox first.
# Accepted modes: sandbox or live. Match Razorpay test or live keys respectively.
QIKINK_MODE=""
QIKINK_CLIENT_ID=""
QIKINK_CLIENT_SECRET=""
